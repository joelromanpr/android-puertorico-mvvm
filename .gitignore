### Android ###
# Built application files
*.apk
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# RenderScript intermediate files
*.rs.o
*.rs.so

# Splash screen files
*.png.flat

# Keystore files
#
# N.B. You should commit the keystore file used to sign your release builds,
# but keep it in a secure location. As such, it's recommended that you add it
# to a second gitignore file, for example .git/info/exclude, which is not
# under version control.
#
# Alternatively, if you're not using a keystore for release builds, you can
# uncomment the following line.
# *.jks

# Android Studio IDE files
.idea/
.gradle/
captures/
*.iml
local.properties
build/

# Profile files
*.hprof

### Gradle ###
.gradletasknamecache

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignoring Gradle wrapper properties file (wrapper folder might be ignored)
!gradle-wrapper.properties

# Lockfiles
# https://docs.gradle.org/current/userguide/dependency_locking.html
*.lockfile

# Crashlytics plugin
com_crashlytics_export_strings.xml

